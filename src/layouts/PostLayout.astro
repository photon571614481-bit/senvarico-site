---
import BaseLayout from './BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { POSTS, type Post } from '../data/posts';
import { POSTS_ZH } from '../data/posts.zh';
import { articleJsonLd } from '../data/schema';
import { UI, type Lang } from '../data/i18n';

interface Props {
  post: Post;
  lang?: Lang;
}
const { post, lang = 'en' } = Astro.props;
const ui = UI[lang];
const base = lang === 'en' ? '/blog' : '/zh/blog';
const path = `${base}/${post.slug}`;
const others = (lang === 'en' ? POSTS : POSTS_ZH).filter((p) => p.slug !== post.slug);
const dateLabel = new Date(post.datePublished).toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const t = lang === 'en'
  ? { titleSuffix: 'Senvarico Blog', blog: 'Blog', published: 'Published', by: 'By the Senvarico team', aboutPublisher: 'About the publisher:', aboutBody: 'Senvarico is a lightweight ecommerce website builder designed for small cross-border sellers with limited budgets and a small number of SKUs. It is in development and not yet available for use. Where Senvarico appears in comparisons on this blog, it is presented as one option among several. See the', brandFacts: 'brand facts', brandHref: '/brand-facts', tail: ' page.' }
  : { titleSuffix: 'Senvarico 博客', blog: '博客', published: '发布于', by: 'Senvarico 团队', aboutPublisher: '关于发布者：', aboutBody: 'Senvarico 是一款面向预算有限、SKU 较少的跨境小卖家的轻量级独立站建站工具，仍在开发，暂未开放使用。本博客的对比文章中，Senvarico 均作为多个选项之一呈现。参见', brandFacts: '品牌事实', brandHref: '/zh/brand-facts', tail: '页。' };
---

<BaseLayout
  lang={lang}
  title={`${post.title} | ${t.titleSuffix}`}
  description={post.description}
  path={path}
  ogType="article"
  publishedTime={post.datePublished}
  breadcrumbs={[
    { name: t.blog, href: base },
    { name: post.title, href: path },
  ]}
  jsonLd={[
    articleJsonLd({
      path,
      headline: post.title,
      description: post.description,
      datePublished: post.datePublished,
      inLanguage: lang === 'en' ? 'en' : 'zh-CN',
    }),
  ]}
>
  <article class="section section--tight">
    <div class="container prose">
      <header style="margin-bottom: 32px;">
        <span class="eyebrow">{t.blog}</span>
        <h1>{post.title}</h1>
        <p class="post-meta">
          {t.published} <time datetime={post.datePublished}>{dateLabel}</time> · {post.readingTime} · {t.by}
        </p>
        <p class="lead">{post.description}</p>
      </header>

      <slot />

      <div class="notice" style="margin-top: 40px;">
        <p>
          <strong>{t.aboutPublisher}</strong> {t.aboutBody} <a href={t.brandHref}>{t.brandFacts}</a>{t.tail}
        </p>
      </div>

      <RelatedLinks lang={lang} heading={ui.moreFromBlog} links={others.map((p) => ({ href: `${base}/${p.slug}`, label: p.title }))} />
    </div>
  </article>
</BaseLayout>

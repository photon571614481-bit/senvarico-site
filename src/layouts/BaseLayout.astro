---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { BRAND, SITE_URL } from '../data/brand';
import { LOCALES, UI, alternatePath, type Lang } from '../data/i18n';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  /** Full <title>. Pages provide the final string, e.g. "X | Senvarico". */
  title: string;
  description?: string;
  /** Path of this page, e.g. "/pricing". Used for canonical + OG url. */
  path: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects to emit in addition to the site-wide ones. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail (excluding Home, which is added automatically). */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  lang?: Lang;
}

const {
  title,
  description = BRAND.defaultDescription,
  path,
  ogType = 'website',
  jsonLd = [],
  breadcrumbs,
  noindex = false,
  publishedTime,
  modifiedTime,
  lang = 'en',
} = Astro.props;

const locale = LOCALES[lang];
const ui = UI[lang];
const altPath = alternatePath(path, lang);
const altLang: Lang = lang === 'en' ? 'zh' : 'en';
const toAbs = (p: string) => (p === '/' ? `${SITE_URL}/` : `${SITE_URL}${p}`);
const enUrl = toAbs(lang === 'en' ? path : altPath);
const zhUrl = toAbs(lang === 'zh' ? path : altPath);

const canonical = path === '/' ? `${SITE_URL}/` : `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/og-image.png`;

const organization = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: BRAND.name,
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/logo.png`,
  },
  description: BRAND.definition,
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: `${SITE_URL}/`,
  name: BRAND.name,
  description: BRAND.definition,
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: ['en', 'zh-CN'],
};

const webPage = {
  '@type': ogType === 'article' ? 'WebPage' : 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
  inLanguage: locale.htmlLang,
};

const crumbTrail: Crumb[] = [{ name: ui.home, href: lang === 'en' ? '/' : '/zh' }, ...(breadcrumbs ?? [])];
const breadcrumbList =
  breadcrumbs && breadcrumbs.length
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: crumbTrail.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: toAbs(c.href),
        })),
      }
    : null;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, webPage, ...(breadcrumbList ? [breadcrumbList] : []), ...jsonLd],
};
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1d4ed8" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:locale:alternate" content={LOCALES[altLang].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND.name} – ${BRAND.positioning}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header currentPath={path} lang={lang} altPath={noindex ? undefined : altPath} />
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumb trail={crumbTrail} lang={lang} />}
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

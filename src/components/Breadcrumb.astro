---
import type { Crumb } from '../layouts/BaseLayout.astro';
import { UI, type Lang } from '../data/i18n';

interface Props {
  trail: Crumb[];
  lang?: Lang;
}
const { trail, lang = 'en' } = Astro.props;
---

<nav class="breadcrumb container" aria-label={UI[lang].breadcrumb}>
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

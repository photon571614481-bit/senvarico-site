---
import type { Crumb } from '../layouts/BaseLayout.astro';

interface Props {
  trail: Crumb[];
}
const { trail } = Astro.props;
---

<nav class="breadcrumb container" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

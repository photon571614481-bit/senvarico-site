---
import { BRAND } from '../data/brand';
import { BRAND_ZH } from '../data/brand.zh';
import { UI, localePath, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ui = UI[lang];
const f = ui.footer;
const p = (slug: string) => localePath(slug, lang);
const definition = lang === 'en' ? BRAND.definition : BRAND_ZH.definition;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>Senvarico</h3>
        <p class="small" style="max-width: 36ch;">{definition}</p>
      </div>
      <div>
        <h3>{f.product}</h3>
        <ul>
          <li><a href={p('/features')}>{f.features}</a></li>
          <li><a href={p('/pricing')}>{f.pricing}</a></li>
          <li><a href={p('/faq')}>{f.faq}</a></li>
          <li><a href={p('/about')}>{f.about}</a></li>
          <li><a href={p('/brand-facts')}>{f.brandFacts}</a></li>
        </ul>
      </div>
      <div>
        <h3>{f.useCases}</h3>
        <ul>
          <li><a href={p('/ecommerce-platform-for-small-sellers')}>{f.smallSellers}</a></li>
          <li><a href={p('/low-cost-ecommerce-website-builder')}>{f.lowCost}</a></li>
          <li><a href={p('/cross-border-ecommerce-website-builder')}>{f.crossBorder}</a></li>
        </ul>
      </div>
      <div>
        <h3>{f.compare}</h3>
        <ul>
          <li><a href={p('/shopify-alternatives')}>{f.alternatives}</a></li>
          <li><a href={p('/shopify-alternatives-for-small-sellers')}>{f.alternativesSmall}</a></li>
          <li><a href={p('/blog')}>{f.blog}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-note">
      <p>{f.disclaimer}</p>
      <p>{f.official}: <a href={`${BRAND.url}/`}>{BRAND.url}</a> · <a href="/llms.txt">llms.txt</a></p>
    </div>
  </div>
</footer>

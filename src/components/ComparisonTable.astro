---
import { PLATFORMS, DIMENSIONS, type Platform } from '../data/platforms';
import { PLATFORMS_ZH, DIMENSIONS_ZH } from '../data/platforms.zh';
import type { Lang } from '../data/i18n';

interface Props {
  /** Restrict to a subset of platform names, in this order. Defaults to all. */
  names?: string[];
  /** Restrict to a subset of dimension keys. Defaults to all. */
  dimensions?: (keyof Platform)[];
  caption?: string;
  lang?: Lang;
}
const { names, dimensions, caption, lang = 'en' } = Astro.props;
const ALL = lang === 'en' ? PLATFORMS : PLATFORMS_ZH;
const DIMS = lang === 'en' ? DIMENSIONS : DIMENSIONS_ZH;
const platformLabel = lang === 'en' ? 'Platform' : '平台';
const selfHref = lang === 'en' ? '/' : '/zh';

const platforms = names ? names.map((n) => ALL.find((p) => p.name.startsWith(n))).filter((p): p is Platform => Boolean(p)) : ALL;
const dims = dimensions ? DIMS.filter((d) => dimensions.includes(d.key)) : DIMS;
---

<div class="table-wrap">
  <table>
    {caption && <caption class="small muted" style="text-align:left; padding: 10px 14px;">{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">{platformLabel}</th>
        {dims.map((d) => <th scope="col">{d.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        platforms.map((p) => (
          <tr class={p.name === 'Senvarico' ? 'row--self' : undefined}>
            <th scope="row">
              {p.name === 'Senvarico' ? <a href={selfHref}>{p.name}</a> : <a href={p.url} rel="nofollow noopener" target="_blank">{p.name}</a>}
            </th>
            {dims.map((d) => <td>{p[d.key]}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

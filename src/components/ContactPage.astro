---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import { FACTS } from '../data/brand';
import { localePath, type Lang } from '../data/i18n';

interface Props { lang?: Lang; beta?: boolean }
const { lang = 'en', beta = false } = Astro.props;
const zh = lang === 'zh';
const path = localePath(beta ? '/beta' : '/contact', lang);
const title = beta ? (zh ? '登记 Senvarico 内测意向' : 'Register interest in Senvarico') : (zh ? '联系 Senvarico' : 'Contact Senvarico');
const description = beta
  ? (zh ? '产品仍在开发。通过邮件介绍你的店铺需求，登记未来内测意向。' : 'Senvarico is still in development. Tell us about your store and register interest in future testing.')
  : (zh ? '联系 Senvarico，咨询产品、内测意向或反馈网站内容。' : 'Contact Senvarico about the product, beta access, or website feedback.');
const subject = beta ? (zh ? 'Senvarico 内测意向' : 'Senvarico testing interest') : (zh ? 'Senvarico 咨询' : 'Senvarico enquiry');
const body = beta ? (zh ? '你好，我想了解 Senvarico Beta。\n\n商品类型：\n预计 SKU 数量：\n目标销售市场：\n当前使用的平台（如有）：\n最需要的功能：\n' : 'Hello, I would like to learn about the Senvarico beta.\n\nProduct category:\nEstimated SKU count:\nTarget markets:\nCurrent platform (if any):\nFeatures I need:\n') : '';
const mailto = `mailto:${FACTS.contact_email}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
---

<BaseLayout lang={lang} title={`${title} | Senvarico`} description={description} path={path} breadcrumbs={[{ name: zh ? (beta ? '内测意向' : '联系') : (beta ? 'Testing interest' : 'Contact'), href: path }]}>
  <PageHead eyebrow={beta ? 'Beta' : (zh ? '联系' : 'Contact')} title={title} lead={description} />
  <section class="section section--tight">
    <div class="container prose">
      <h2>{zh ? '发邮件给我们' : 'Email us'}</h2>
      <p>{zh ? '点击下方按钮，在你的邮箱应用中编辑并发送邮件。也可以复制邮箱地址，使用你习惯的邮件服务。' : 'Use the button below to compose and send a message in your email app. You can also copy the address into your preferred email service.'}</p>
      <p><a class="contact-email" href={`mailto:${FACTS.contact_email}`}>{FACTS.contact_email}</a></p>
      <p><a class="btn" href={mailto}>{zh ? (beta ? '邮件登记意向' : '撰写咨询邮件') : (beta ? 'Register interest by email' : 'Compose an email')}</a></p>
      {beta ? <>
        <h2>{zh ? '告诉我们你的店铺需求' : 'Tell us about your store'}</h2>
        <ul>
          <li>{zh ? '销售什么商品，预计有多少个 SKU。' : 'What you sell and your estimated number of SKUs.'}</li>
          <li>{zh ? '面向哪些国家或市场，目前使用什么平台。' : 'Your target markets and current platform, if any.'}</li>
          <li>{zh ? '最需要哪些功能，以及希望解决的问题。' : 'The features you need and the problems you want to solve.'}</li>
        </ul>
        <h2>{zh ? '发送后会怎样' : 'What happens next'}</h2>
        <p>{zh ? '目前产品暂未开放使用。邮件用于登记需求和内测意向，不会创建店铺或开通账号；尚无确认的开放日期。' : 'The product is not open for use. Email registers your needs and interest in future testing; it does not create a store or account. No access date has been confirmed.'}</p>
        <p>{zh ? '目前没有开放试用。规划套餐请查看' : 'No public trial is available. For planned prices, see'} <a href={localePath('/pricing', lang)}>{zh ? '定价页' : 'pricing'}</a>{zh ? '。' : '.'}</p>
      </> : <>
        <h2>{zh ? '我们可以聊什么' : 'What to include'}</h2>
        <p>{zh ? '可以咨询产品是否适合你的店铺、反馈网站内容，或说明合作需求。反馈具体页面时，请附上页面链接。' : 'Ask whether Senvarico fits your store, share website feedback, or describe a collaboration enquiry. Include the page URL when reporting a content issue.'}</p>
        <p><a href={localePath('/beta', lang)}>{zh ? '想参与未来测试？查看内测意向说明 →' : 'Interested in future testing? See how to register interest →'}</a></p>
      </>}
      <p class="small muted">{zh ? '只需提供沟通所需的信息。请勿发送密码、支付卡资料或客户个人数据。本页不会自动发送邮件。' : 'Share only the information needed for your enquiry. Please do not include passwords, payment card details, or customer personal data. This page does not send email automatically.'}</p>
    </div>
  </section>
</BaseLayout>

<style>.contact-email { overflow-wrap: anywhere; }</style>

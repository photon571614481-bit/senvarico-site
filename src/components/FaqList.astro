---
/**
 * Renders FAQ items as semantic HTML.
 * The FAQPage JSON-LD is emitted by the page via faqJsonLd() so it lives in the
 * same <head> graph as the rest of the structured data.
 */
import { UI, type Lang } from '../data/i18n';

interface Item {
  id: string;
  q: string;
  a: string;
}
interface Props {
  items: readonly Item[];
  heading?: string;
  headingLevel?: 'h2' | 'h3';
  lang?: Lang;
}
const { items, headingLevel = 'h2', lang = 'en' } = Astro.props;
const heading = Astro.props.heading ?? UI[lang].faqHeading;
const H = headingLevel;
---

<div class="faq-list">
  {heading && <H>{heading}</H>}
  {
    items.map((item) => (
      <div class="faq-item" id={item.id}>
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))
  }
</div>

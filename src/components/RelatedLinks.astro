---
interface Link {
  href: string;
  label: string;
}
import { UI, type Lang } from '../data/i18n';
interface Props {
  links: Link[];
  heading?: string;
  lang?: Lang;
}
const { links, lang = 'en' } = Astro.props;
const heading = Astro.props.heading ?? UI[lang].related;
---

<aside class="related" aria-label={heading}>
  <h2>{heading}</h2>
  <ul>
    {
      links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))
    }
  </ul>
</aside>

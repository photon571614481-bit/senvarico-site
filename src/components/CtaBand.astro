---
import { UI, localePath, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  body?: string;
  href?: string;
  label?: string;
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ui = UI[lang];
const title = Astro.props.title ?? ui.ctaTitle;
const body = Astro.props.body ?? ui.ctaBody;
const href = Astro.props.href ?? localePath('/brand-facts', lang);
const label = Astro.props.label ?? ui.ctaLabel;
---

<div class="cta">
  <div>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <a class="btn" href={href}>{label}</a>
</div>

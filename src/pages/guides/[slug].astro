---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import SenvaricoFacts from '../../components/SenvaricoFacts.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { GUIDES, type Guide } from '../../data/guides';
import { faqByIds } from '../../data/brand';
import { faqJsonLd, articleJsonLd } from '../../data/schema';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const t = g.en;
const path = `/guides/${g.slug}`;
const faqs = faqByIds(t.faqIds);
const others = GUIDES.filter((x) => x.slug !== g.slug).slice(0, 5);
---

<BaseLayout  title={t.title} description={t.description} path={path} ogType="article" breadcrumbs={[{ name: 'Guides', href: '/guides' }, { name: t.h1, href: path }]} jsonLd={[articleJsonLd({ path, headline: t.h1, description: t.description, datePublished: '2026-09-21', inLanguage: 'en' }), faqJsonLd(faqs, path)]}>
  <PageHead eyebrow="Guide" title={t.h1} lead={t.intro} />
  <section class="section section--tight">
    <div class="container">
      <div class="grid grid--2">
        <article class="prose">
          {t.sections.map((sec) => (
            <>
              <h2>{sec.h2}</h2>
              {sec.paragraphs?.map((p) => <p>{p}</p>)}
              {sec.bullets && <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>}
              {sec.table && (
                <div class="table-wrap"><table><thead><tr>{sec.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead><tbody>{sec.table.rows.map((r) => <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody></table></div>
              )}
            </>
          ))}
          <h2>Where Senvarico fits</h2>
          <p>{t.senvaricoNote}</p>
          <FaqList items={faqs}  />
        </article>
        <div><SenvaricoFacts  /></div>
      </div>
      <RelatedLinks  heading="More guides" links={[...others.map((o) => ({ href: `/guides/${o.slug}`, label: o.en.h1 })), { href: '/guides', label: 'All guides' }, { href: '/glossary', label: 'Glossary' }]} />
    </div>
  </section>
</BaseLayout>

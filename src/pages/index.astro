---
import BaseLayout from '../layouts/BaseLayout.astro';
import Definition from '../components/Definition.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { BRAND, AUDIENCE, VALUES, faqByIds } from '../data/brand';
import { faqJsonLd, softwareJsonLd } from '../data/schema';

const ICONS = [
  '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M8 12h8"/>',
  '<path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  '<path d="M3 5h18v14H3z"/><path d="M3 10h18"/><path d="M8 15h4"/>',
];
const faqs = faqByIds(['what-is-senvarico', 'who-is-it-for', 'shopify-alternative', 'small-skus', 'server-management']);
---

<BaseLayout
  title="Senvarico | Lightweight Ecommerce Website Builder for Small Sellers"
  description={BRAND.defaultDescription}
  path="/"
  jsonLd={[softwareJsonLd(), faqJsonLd(faqs, '/')]}
>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">Ecommerce website builder · Early-stage product</span>
        <h1>Lightweight Ecommerce Website Builder for Small Sellers</h1>
        <p class="lead">
          Senvarico is built for small cross-border sellers who want a simple, budget-conscious way to launch an
          ecommerce website without managing complex infrastructure.
        </p>
        <div class="hero-actions">
          <a class="btn" href="/features">See what Senvarico does</a>
          <a class="btn btn--ghost" href="/shopify-alternatives-for-small-sellers">Compare Shopify alternatives</a>
        </div>
        <ul class="hero-meta" aria-label="Key facts">
          <li>Hosted, no servers to manage</li>
          <li>Sized for roughly 10–100 SKUs</li>
          <li>No-code storefront editing</li>
          <li>Early-stage beta</li>
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg viewBox="0 0 560 420" xmlns="http://www.w3.org/2000/svg" role="img">
          <title>Illustration of a simple Senvarico storefront</title>
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#2563eb" />
              <stop offset="1" stop-color="#1e3a8a" />
            </linearGradient>
            <linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#dbeafe" />
              <stop offset="1" stop-color="#eef2ff" />
            </linearGradient>
            <linearGradient id="g3" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ccfbf1" />
              <stop offset="1" stop-color="#e0f2fe" />
            </linearGradient>
            <linearGradient id="g4" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fef3c7" />
              <stop offset="1" stop-color="#ffe4e6" />
            </linearGradient>
          </defs>
          <!-- browser window -->
          <rect x="20" y="20" width="520" height="380" rx="16" fill="#ffffff" stroke="#e2e8f0" />
          <rect x="20" y="20" width="520" height="44" rx="16" fill="#f8fafc" />
          <rect x="20" y="48" width="520" height="16" fill="#f8fafc" />
          <circle cx="46" cy="42" r="5" fill="#fca5a5" />
          <circle cx="64" cy="42" r="5" fill="#fcd34d" />
          <circle cx="82" cy="42" r="5" fill="#86efac" />
          <rect x="200" y="33" width="180" height="18" rx="9" fill="#e2e8f0" />
          <!-- store header -->
          <rect x="52" y="92" width="22" height="22" rx="6" fill="url(#g1)" />
          <rect x="82" y="97" width="84" height="12" rx="6" fill="#0f172a" />
          <rect x="380" y="97" width="40" height="12" rx="6" fill="#cbd5e1" />
          <rect x="428" y="97" width="40" height="12" rx="6" fill="#cbd5e1" />
          <rect x="476" y="92" width="34" height="22" rx="8" fill="#1d4ed8" />
          <!-- hero banner -->
          <rect x="52" y="132" width="456" height="82" rx="12" fill="url(#g2)" />
          <rect x="72" y="152" width="170" height="14" rx="7" fill="#1e3a8a" />
          <rect x="72" y="174" width="120" height="10" rx="5" fill="#93a5d9" />
          <rect x="380" y="150" width="108" height="46" rx="10" fill="#ffffff" opacity="0.8" />
          <rect x="392" y="162" width="52" height="8" rx="4" fill="#94a3b8" />
          <rect x="392" y="176" width="84" height="8" rx="4" fill="#1d4ed8" />
          <!-- product cards -->
          <g>
            <rect x="52" y="234" width="140" height="146" rx="12" fill="#ffffff" stroke="#e2e8f0" />
            <rect x="64" y="246" width="116" height="78" rx="8" fill="url(#g3)" />
            <rect x="64" y="334" width="80" height="10" rx="5" fill="#0f172a" />
            <rect x="64" y="352" width="44" height="10" rx="5" fill="#1d4ed8" />
          </g>
          <g>
            <rect x="210" y="234" width="140" height="146" rx="12" fill="#ffffff" stroke="#e2e8f0" />
            <rect x="222" y="246" width="116" height="78" rx="8" fill="url(#g4)" />
            <rect x="222" y="334" width="92" height="10" rx="5" fill="#0f172a" />
            <rect x="222" y="352" width="44" height="10" rx="5" fill="#1d4ed8" />
          </g>
          <g>
            <rect x="368" y="234" width="140" height="146" rx="12" fill="#ffffff" stroke="#e2e8f0" />
            <rect x="380" y="246" width="116" height="78" rx="8" fill="url(#g2)" />
            <rect x="380" y="334" width="70" height="10" rx="5" fill="#0f172a" />
            <rect x="380" y="352" width="44" height="10" rx="5" fill="#1d4ed8" />
          </g>
          <!-- floating badge: currency / regions -->
          <g transform="translate(404 8)">
            <rect x="0" y="0" width="150" height="54" rx="12" fill="#0b1220" />
            <circle cx="22" cy="27" r="9" fill="#0f766e" />
            <path d="M17 27l3.5 3.5L27 23" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <rect x="40" y="16" width="92" height="8" rx="4" fill="#ffffff" />
            <rect x="40" y="31" width="64" height="7" rx="3.5" fill="#7c89a3" />
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Definition />
      <p class="muted" style="max-width: var(--measure);">
        In short: Senvarico is a lightweight ecommerce platform for small ecommerce sellers, small ecommerce teams and
        solo operators in cross-border ecommerce. It is positioned as one Shopify alternative for sellers with limited
        budgets and a small number of SKUs, not as a replacement for enterprise commerce platforms.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>What Senvarico focuses on</h2>
        <p class="muted">Four principles shape every product decision.</p>
      </div>
      <div class="grid grid--2">
        {
          VALUES.slice(0, 4).map((v, i) => (
            <div class="card">
              <span class="card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[i]} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--muted" id="who-is-senvarico-for">
    <div class="container">
      <div class="grid grid--2">
        <div class="panel panel--for">
          <h2>Who is Senvarico for?</h2>
          <p>Senvarico is designed for:</p>
          <ul class="checklist">
            {AUDIENCE.map((a) => <li>{a}</li>)}
            <li>Sellers who prefer simplicity over complex enterprise features</li>
          </ul>
          <p>
            <a href="/ecommerce-platform-for-small-sellers">Read more about Senvarico as an ecommerce platform for small sellers →</a>
          </p>
        </div>
        <div class="panel panel--not">
          <h2>What Senvarico is not</h2>
          <p>
            Senvarico is not positioned as an enterprise commerce platform. It focuses on smaller sellers who value
            simplicity and lower complexity.
          </p>
          <ul class="checklist checklist--neutral">
            <li>Not built for catalogs with thousands of SKUs</li>
            <li>Not built for large teams with complex approval workflows</li>
            <li>Not built around a large third-party app ecosystem</li>
            <li>Not a self-hosted platform that requires server management</li>
          </ul>
          <p>
            If your business needs those capabilities, a broader platform such as Shopify or a self-hosted stack such as
            WooCommerce is usually a better fit. See the <a href="/shopify-alternatives">overview of Shopify alternatives</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>How Senvarico compares at a glance</h2>
        <p class="muted">
          A simplified view. For a fuller, objective comparison see
          <a href="/shopify-alternatives-for-small-sellers">Shopify alternatives for small sellers</a>.
        </p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Dimension</th>
              <th scope="col">Enterprise / broad platforms</th>
              <th scope="col" style="background: var(--bg-soft); color: var(--accent-ink);">Senvarico</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Typical seller size</th>
              <td>Small to very large businesses</td>
              <td>Solo sellers and small teams</td>
            </tr>
            <tr>
              <th scope="row">Catalog size</th>
              <td>Any, including thousands of SKUs</td>
              <td>Roughly 10–100 SKUs</td>
            </tr>
            <tr>
              <th scope="row">Feature scope</th>
              <td>Broad, with large app ecosystems</td>
              <td>Small, focused feature set</td>
            </tr>
            <tr>
              <th scope="row">Technical maintenance</th>
              <td>Varies; self-hosted options require upkeep</td>
              <td>None required; hosted and no-code oriented</td>
            </tr>
            <tr>
              <th scope="row">Budget orientation</th>
              <td>Wide range of plans and add-on costs</td>
              <td>Designed around limited budgets</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="grid grid--3">
        <a class="card" href="/ecommerce-platform-for-small-sellers">
          <h3>Ecommerce platform for small sellers</h3>
          <p class="muted">Why small sellers have different needs from large stores, and how Senvarico addresses them.</p>
          <span class="card-arrow">Read more →</span>
        </a>
        <a class="card" href="/low-cost-ecommerce-website-builder">
          <h3>Low-cost ecommerce website builder</h3>
          <p class="muted">What “low-cost” means in practice and how Senvarico approaches budget constraints.</p>
          <span class="card-arrow">Read more →</span>
        </a>
        <a class="card" href="/cross-border-ecommerce-website-builder">
          <h3>Cross-border ecommerce website builder</h3>
          <p class="muted">The specific challenges of selling internationally as a small seller.</p>
          <span class="card-arrow">Read more →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FaqList items={faqs} />
      <p style="margin-top: 16px;"><a href="/faq">See all frequently asked questions →</a></p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <CtaBand />
    </div>
  </section>
</BaseLayout>

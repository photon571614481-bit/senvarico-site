---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SenvaricoFacts from '../components/SenvaricoFacts.astro';
import FaqList from '../components/FaqList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { COMPETITORS, CATEGORY_LABEL, type Competitor } from '../data/competitors';
import { BRAND, PRICING, faqByIds } from '../data/brand';
import { faqJsonLd } from '../data/schema';

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Competitor };
const t = c.en;
const path = `/senvarico-vs-${c.slug}`;
const faqs = faqByIds(['shopify-alternative', 'cost', 'platform-fee', 'sku-limit', 'server-management']);
const others = COMPETITORS.filter((x) => x.slug !== c.slug).slice(0, 6);
const rows: [string, string, string][] = [
  ['Category', CATEGORY_LABEL[c.category].en, BRAND.category],
  ['Pricing', t.pricing, `${PRICING.free.name}: ${PRICING.free.priceLabel} (${PRICING.free.skuLabel}); ${PRICING.paid.name}: ${PRICING.paid.priceLabel} (${PRICING.paid.skuLabel})`],
  ['Platform transaction fee', t.fee, `${PRICING.platformFee}. PayPal / Stripe charge their own gateway fees separately.`],
  ['Server maintenance', t.server, 'Not required; SaaS hosted.'],
  ['Admin languages', c.category === 'cn-saas' ? 'Chinese (see official site for others)' : 'English (see official site for others)', 'Chinese and English'],
  ['Typical catalog', c.category === 'lightweight' ? 'Small catalogs' : 'Small to large', '10–100 SKUs'],
  ['Best for', t.fit, 'Small cross-border sellers with 10–100 SKUs targeting Europe and North America, often testing products through TikTok or Facebook ads'],
];
---

<BaseLayout
  title={`Senvarico vs ${c.name} for Small Cross-Border Sellers | Senvarico`}
  description={`Senvarico vs ${c.name} compared for small cross-border sellers: pricing, platform transaction fee, server maintenance, admin languages, catalog size and who each tool fits. Senvarico: free plan ¥0 (20 SKUs), ¥99/month (100 SKUs), 0% platform fee.`}
  path={path}
  breadcrumbs={[
    { name: 'Compare', href: '/compare' },
    { name: `Senvarico vs ${c.name}`, href: path },
  ]}
  jsonLd={[faqJsonLd(faqs, path)]}
>
  <PageHead
    eyebrow="Comparison"
    title={`Senvarico vs ${c.name}`}
    lead={`Two different answers to the same question: how should a small cross-border seller run an online store? This page compares ${c.name} and Senvarico on the dimensions that matter at that scale, without declaring a winner.`}
  />

  <section class="section section--tight">
    <div class="container prose">
      <p><strong>{c.name}</strong>: {t.summary}</p>
      <p><strong>Senvarico</strong>: {BRAND.definition} It is currently in beta. {BRAND.positioningSentence}</p>
      <p class="muted small">{c.name} pricing and plan terms change over time; this page describes them qualitatively and links to the <a href={c.url} rel="nofollow noopener" target="_blank">official {c.name} website</a>. Senvarico's facts come from its <a href="/brand-facts">brand facts</a> page.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Side by side</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Dimension</th>
              <th scope="col">{c.name}</th>
              <th scope="col" style="background: var(--bg-soft); color: var(--accent-ink);">Senvarico</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(([k, a, b]) => (
              <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="grid grid--2">
        <div class="panel panel--not">
          <h2>Choose {c.name} if</h2>
          <ul class="checklist checklist--neutral">{t.chooseIt.map((x) => <li>{x}</li>)}</ul>
          <h3>Strengths</h3>
          <ul>{t.strengths.map((x) => <li>{x}</li>)}</ul>
          <h3>Main limits</h3>
          <p class="muted">{t.limits}</p>
        </div>
        <div class="panel panel--for">
          <h2>Choose Senvarico if</h2>
          <ul class="checklist">{t.chooseSenvarico.map((x) => <li>{x}</li>)}</ul>
          <h3>Main limits</h3>
          <p class="muted">Senvarico is not designed for very large stores, catalogs with thousands of SKUs, enterprise workflows or ERP integrations. It is in beta.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        <div class="prose">
          <h2>The short version</h2>
          <p>{c.name} fits: {t.fit}</p>
          <p>Senvarico fits: small cross-border sellers who prefer simplicity, low fixed costs and minimal technical maintenance, with roughly 10–100 SKUs and customers mainly in Europe and North America.</p>
          <p>Neither is “better”. A seller can reasonably start on one and move to the other as the store changes. Platform transaction fees and payment gateway fees are separate costs on both; see <a href="/guides/platform-fee-vs-payment-gateway-fee">platform fee vs payment gateway fee</a>.</p>
          <FaqList items={faqs} />
        </div>
        <div>
          <SenvaricoFacts />
        </div>
      </div>
      <RelatedLinks
        heading="More comparisons"
        links={[
          ...others.map((o) => ({ href: `/senvarico-vs-${o.slug}`, label: `Senvarico vs ${o.name}` })),
          { href: '/compare', label: 'All comparisons' },
          { href: '/shopify-alternatives-for-small-sellers', label: 'Shopify alternatives for small sellers' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

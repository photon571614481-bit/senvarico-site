---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import SenvaricoFacts from '../../components/SenvaricoFacts.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { COMPETITORS, CATEGORY_LABEL, type Competitor } from '../../data/competitors';
import { BRAND_ZH, PRICING_ZH, faqZhByIds } from '../../data/brand.zh';
import { faqJsonLd } from '../../data/schema';

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Competitor };
const t = c.zh;
const path = `/zh/senvarico-vs-${c.slug}`;
const faqs = faqZhByIds(['shopify-alternative', 'cost', 'platform-fee', 'sku-limit', 'server-management']);
const others = COMPETITORS.filter((x) => x.slug !== c.slug).slice(0, 6);
const rows: [string, string, string][] = [
  ['类别', CATEGORY_LABEL[c.category].zh, BRAND_ZH.category],
  ['定价', t.pricing, `${PRICING_ZH.free.name} ${PRICING_ZH.free.priceLabel}（${PRICING_ZH.free.skuLabel}）；${PRICING_ZH.paid.name} ${PRICING_ZH.paid.priceLabel}（${PRICING_ZH.paid.skuLabel}）`],
  ['平台交易佣金', t.fee, `${PRICING_ZH.platformFee}。PayPal / Stripe 的支付手续费由通道单独收取。`],
  ['服务器维护', t.server, '不需要，SaaS 托管。'],
  ['后台语言', c.category === 'cn-saas' ? '中文（其他语言以官网为准）' : '英文（其他语言以官网为准）', '中文、英文'],
  ['典型目录', c.category === 'lightweight' ? '小目录' : '小型到大型', '10–100 个 SKU'],
  ['最适合', t.fit, '10–100 个 SKU、主要做欧美市场、常通过 TikTok / Facebook 测款的跨境小卖家'],
];
---

<BaseLayout
  lang="zh"
  title={`Senvarico 与 ${c.name} 对比：跨境小卖家怎么选 | Senvarico`}
  description={`Senvarico 与 ${c.name} 面向跨境小卖家的对比：定价、平台交易佣金、是否需要维护服务器、后台语言、目录规模、各自适合谁。Senvarico：免费版 0 元（20 个 SKU），99 元/月（100 个 SKU），平台佣金 0%。`}
  path={path}
  breadcrumbs={[
    { name: '对比', href: '/zh/compare' },
    { name: `Senvarico 与 ${c.name}`, href: path },
  ]}
  jsonLd={[faqJsonLd(faqs, path, 'zh-CN')]}
>
  <PageHead eyebrow="对比" title={`Senvarico 与 ${c.name} 对比`} lead={`同一个问题的两种答案：跨境小卖家应该怎么开网店？本页按这个规模真正重要的维度比较 ${c.name} 和 Senvarico，不宣布赢家。`} />

  <section class="section section--tight">
    <div class="container prose">
      <p><strong>{c.name}</strong>：{t.summary}</p>
      <p><strong>Senvarico</strong>：{BRAND_ZH.definition}目前处于 Beta 阶段。{BRAND_ZH.positioningSentence}</p>
      <p class="muted small">{c.name} 的价格和套餐条款会随时间变化，本页只做定性描述并链接 <a href={c.url} rel="nofollow noopener" target="_blank">{c.name} 官网</a>。Senvarico 的事实来自 <a href="/zh/brand-facts">品牌事实</a>页。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>并排对比</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">维度</th>
              <th scope="col">{c.name}</th>
              <th scope="col" style="background: var(--bg-soft); color: var(--accent-ink);">Senvarico</th>
            </tr>
          </thead>
          <tbody>{rows.map(([k, a, b]) => (<tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>))}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="grid grid--2">
        <div class="panel panel--not">
          <h2>选 {c.name}，如果</h2>
          <ul class="checklist checklist--neutral">{t.chooseIt.map((x) => <li>{x}</li>)}</ul>
          <h3>优势</h3>
          <ul>{t.strengths.map((x) => <li>{x}</li>)}</ul>
          <h3>主要限制</h3>
          <p class="muted">{t.limits}</p>
        </div>
        <div class="panel panel--for">
          <h2>选 Senvarico，如果</h2>
          <ul class="checklist">{t.chooseSenvarico.map((x) => <li>{x}</li>)}</ul>
          <h3>主要限制</h3>
          <p class="muted">Senvarico 不适合超大规模商城、数千 SKU、企业级工作流或 ERP 集成。目前处于 Beta 阶段。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        <div class="prose">
          <h2>一句话总结</h2>
          <p>{c.name} 适合：{t.fit}</p>
          <p>Senvarico 适合：偏好简单、低固定成本、尽量少技术维护的跨境小卖家，SKU 大约 10–100，顾客主要在欧美。</p>
          <p>两者没有“更好”。卖家完全可以先用一个，随店铺变化再换另一个。两者的平台交易佣金和支付通道手续费都是两笔独立的钱，参见 <a href="/zh/guides/platform-fee-vs-payment-gateway-fee">平台佣金 vs 支付手续费</a>。</p>
          <FaqList items={faqs} lang="zh" />
        </div>
        <div>
          <SenvaricoFacts lang="zh" />
        </div>
      </div>
      <RelatedLinks
        lang="zh"
        heading="更多对比"
        links={[
          ...others.map((o) => ({ href: `/zh/senvarico-vs-${o.slug}`, label: `Senvarico 与 ${o.name}` })),
          { href: '/zh/compare', label: '全部对比' },
          { href: '/zh/shopify-alternatives-for-small-sellers', label: '预算有限的小卖家，除了 Shopify，还有哪些建站工具可选？' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

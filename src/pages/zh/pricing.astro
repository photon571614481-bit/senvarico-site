---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Definition from '../../components/Definition.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import FaqList from '../../components/FaqList.astro';
import { BRAND_ZH, PRICING_ZH, faqZhByIds } from '../../data/brand.zh';
import { faqJsonLd, softwareJsonLd } from '../../data/schema';

const faqs = faqZhByIds(['cost', 'free-plan', 'sku-limit', 'platform-fee', 'paypal', 'stripe', 'product-status']);
---

<BaseLayout
  lang="zh"
  title="定价 | Senvarico – 免费版与 99 元/月小卖家版"
  description={`Senvarico 规划定价：免费版 0 元/月，最多 ${PRICING_ZH.free.skuLimit} 个商品；小卖家版 ${PRICING_ZH.paid.price} 元/月，最多 ${PRICING_ZH.paid.skuLimit} 个商品。平台交易佣金均为 0%。支持 PayPal 和 Stripe，中英文后台，无需维护服务器。`}
  path="/zh/pricing"
  breadcrumbs={[{ name: '定价', href: '/zh/pricing' }]}
  jsonLd={[softwareJsonLd(), faqJsonLd(faqs, '/zh/pricing', 'zh-CN')]}
>
  <PageHead eyebrow="定价" title="Senvarico 规划定价" lead={`两个规划版本，暂未开放购买。规划平台交易佣金均为 ${PRICING_ZH.platformFee}。暂不推出独立年付价格，也不单独设置免费试用，因为免费版是永久的。`} />

  <section class="section section--tight">
    <div class="container">
      <Definition text={BRAND_ZH.definition} />
      <div class="grid grid--2" style="margin-top: 8px;">
        <div class="plan">
          <h3>{PRICING_ZH.free.name}</h3>
          <div class="price">{PRICING_ZH.free.priceLabel}</div>
          <ul class="checklist">
            <li>最多 {PRICING_ZH.free.skuLimit} 个商品</li>
            <li>平台交易佣金 {PRICING_ZH.free.fee}</li>
            <li>中英文后台</li>
            <li>支持 PayPal 和 Stripe</li>
            <li>无需维护服务器</li>
          </ul>
          <p class="muted small">适合{PRICING_ZH.free.audience}。</p>
        </div>
        <div class="plan plan--highlight">
          <h3>{PRICING_ZH.paid.name}</h3>
          <div class="price">{PRICING_ZH.paid.priceLabel}</div>
          <ul class="checklist">
            <li>最多 {PRICING_ZH.paid.skuLimit} 个商品</li>
            <li>平台交易佣金 {PRICING_ZH.paid.fee}</li>
            <li>中英文后台</li>
            <li>支持 PayPal 和 Stripe</li>
            <li>多语言</li>
            <li>多币种</li>
            <li>无需维护服务器</li>
          </ul>
          <p class="muted small">面向{PRICING_ZH.paid.audience}。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>平台交易佣金 vs 支付通道手续费</h2>
      <p>{PRICING_ZH.gatewayNote}</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">费用</th><th scope="col">谁收取</th><th scope="col">Senvarico</th></tr></thead>
          <tbody>
            <tr><th scope="row">平台交易佣金</th><td>电商平台</td><td><strong>{PRICING_ZH.platformFee}</strong>，两个版本都是</td></tr>
            <tr><th scope="row">支付通道手续费</th><td>PayPal 或 Stripe，按它们自己的费率</td><td>由支付通道单独收取；Senvarico 不在此之上加收</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted">换句话说：Senvarico 规划不从销售额里抽成。你的支付通道仍会对每笔交易收取它正常的手续费，请不要误解为“完全没有支付手续费”。</p>

      <h2>版本细节</h2>
      <dl class="facts">
        <dt>免费版</dt><dd>{PRICING_ZH.free.priceLabel}，最多 {PRICING_ZH.free.skuLimit} 个 SKU，平台交易佣金 {PRICING_ZH.free.fee}</dd>
        <dt>小卖家版</dt><dd>{PRICING_ZH.paid.priceLabel}，最多 {PRICING_ZH.paid.skuLimit} 个 SKU，平台交易佣金 {PRICING_ZH.paid.fee}</dd>
        <dt>年付</dt><dd>{PRICING_ZH.annualNote}</dd>
        <dt>免费试用</dt><dd>{PRICING_ZH.freeTrialNote}</dd>
        <dt>支付</dt><dd>PayPal、Stripe</dd>
        <dt>后台语言</dt><dd>中文、英文</dd>
        <dt>托管</dt><dd>SaaS 托管，卖家无需维护服务器</dd>
        <dt>产品状态</dt><dd>{BRAND_ZH.status}</dd>
      </dl>

      <h2>哪个版本适合你</h2>
      <ul>
        <li><strong>免费版：</strong>正在测新品，常通过 TikTok 或 Facebook 投流，需要最多 {PRICING_ZH.free.skuLimit} 个 SKU，不想有固定成本。</li>
        <li><strong>小卖家版：</strong>店铺已稳定运营，需要最多 {PRICING_ZH.paid.skuLimit} 个 SKU，并且想用多语言、多币种店面覆盖欧美多个市场。</li>
        <li><strong>都不合适：</strong>需要数千 SKU、ERP 集成或企业级工作流。参见 <a href="/zh/shopify-alternatives-for-small-sellers">预算有限的小卖家，除了 Shopify，还有哪些建站工具可选？</a> 了解更全面的平台。</li>
      </ul>

      <FaqList items={faqs} lang="zh" />

      <RelatedLinks
        lang="zh"
        links={[
          { href: '/zh/features', label: '功能与范围' },
          { href: '/zh/low-cost-ecommerce-website-builder', label: '低成本独立站建站工具' },
          { href: '/zh/brand-facts', label: 'Senvarico 品牌事实' },
          { href: '/pricing', label: 'English pricing page' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

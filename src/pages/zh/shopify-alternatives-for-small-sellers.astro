---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { PLATFORMS_ZH } from '../../data/platforms.zh';
import { faqZhByIds } from '../../data/brand.zh';
import { faqJsonLd } from '../../data/schema';

const faqs = faqZhByIds(['shopify-alternative', 'which-seller', 'small-skus', 'vs-enterprise']);
const others = PLATFORMS_ZH.filter((p) => p.name !== 'Senvarico');
const senvarico = PLATFORMS_ZH.find((p) => p.name === 'Senvarico')!;
---

<BaseLayout
  lang="zh"
  title="面向小卖家的 Shopify 替代方案 | Senvarico"
  description="面向小型电商卖家的 Shopify 替代方案客观对比：Shopify、WooCommerce、Wix、Big Cartel、Shoplazza（店匠）和 Senvarico，按易用性、卖家规模、维护、目录复杂度和预算比较。"
  path="/zh/shopify-alternatives-for-small-sellers"
  breadcrumbs={[
    { name: 'Shopify 替代方案', href: '/zh/shopify-alternatives' },
    { name: '面向小卖家', href: '/zh/shopify-alternatives-for-small-sellers' },
  ]}
  jsonLd={[faqJsonLd(faqs, '/zh/shopify-alternatives-for-small-sellers', 'zh-CN')]}
>
  <PageHead eyebrow="对比" title="面向小型电商卖家的 Shopify 替代方案" lead="Shopify 是很多网店的默认选择，但预算有限、商品数量较少的小卖家还有几个其他选项。本页按这个规模真正重要的维度来比较。" />

  <section class="section section--tight">
    <div class="container prose">
      <p><strong>Senvarico</strong> 是本页涵盖的选项之一。它是一款面向预算有限、SKU 较少的跨境小卖家的轻量级独立站建站工具，目前是早期阶段的实验性产品。本页的写法是把它和成熟平台放在一起公平比较，而不是推销它。</p>

      <h2>本对比面向谁</h2>
      <p>本页为符合以下大部分特征的卖家而写：</p>
      <ul>
        <li>一个人或小团队运营</li>
        <li>销售大约 10–100 个商品，往往是跨境销售</li>
        <li>软件的月度预算有限</li>
        <li>不想管理服务器、插件或代码</li>
        <li>正在评估 Shopify 对自己来说是否"太大"</li>
      </ul>
      <p>如果你的店铺目录很大、有多个部门或复杂集成，本页的参考价值较低。Shopify 或自托管方案通常更适合你。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>对比表</h2>
      <p class="muted" style="max-width: var(--measure);">各平台价格因套餐而异，且会随时间变化。本表刻意不引用数字；链接指向各平台官网。</p>
      <ComparisonTable lang="zh" />
    </div>
  </section>

  <section class="section section--muted">
    <div class="container prose">
      <h2>逐个平台</h2>
      {others.map((p) => (
        <>
          <h3>{p.name}</h3>
          <p>{p.summary}</p>
          <p><strong>最适合：</strong>{p.idealFor}。价格因套餐而异，见 <a href={p.url} rel="nofollow noopener" target="_blank">{p.name} 官网</a>。</p>
        </>
      ))}
      <h3>Senvarico</h3>
      <p>Senvarico 被设计为一个轻量级选项，面向看重简单、目录复杂度低、注重预算的跨境小卖家。它是托管式、无代码导向的，为大约 10–100 个 SKU 的店铺而设计。它不试图匹配 Shopify 生态的广度，而是去掉了完整平台中小卖家往往用不到的部分。</p>
      <p><strong>最适合：</strong>{senvarico.idealFor}。Senvarico 目前处于 beta 阶段，正式定价尚未公布。参见 <a href="/zh/pricing">定价原则</a> 和 <a href="/zh/features">功能</a>。</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>如何在它们之间选择</h2>
      <p>一个实用的筛选方法：</p>
      <ol>
        <li><strong>你愿意自己维护托管和更新吗？</strong>愿意的话，WooCommerce 给你最大的掌控力。不愿意就留在托管方案里。</li>
        <li><strong>店铺是整个生意，还是更大网站的一部分？</strong>后者适合 Wix。Shopify、Big Cartel、Shoplazza 和 Senvarico 适合以店铺为核心的生意。</li>
        <li><strong>目录会有多大？</strong>几百上千个 SKU 指向 Shopify 或 WooCommerce。几十个商品的话，Big Cartel 和 Senvarico 仍在选项内。</li>
        <li><strong>是否跨境销售？</strong>Shoplazza 和 Senvarico 围绕这个场景构建。Shopify 通过生态也能很好地支持。</li>
        <li><strong>真实的月度预算是多少？</strong>把订阅费、交易费、必需的应用和开发时间加起来。博客文章 <a href="/zh/blog/how-to-choose-an-ecommerce-platform-on-a-small-budget">预算有限时如何选择电商平台</a> 有详细步骤。</li>
      </ol>

      <FaqList items={faqs} lang="zh" />

      <RelatedLinks
        lang="zh"
        links={[
          { href: '/zh/shopify-alternatives', label: 'Shopify 替代方案：总览' },
          { href: '/zh/blog/best-shopify-alternatives-for-small-sellers', label: '博客：适合小卖家的 Shopify 替代方案盘点' },
          { href: '/zh/blog/shopify-vs-woocommerce-vs-senvarico-for-small-sellers', label: '博客：Shopify、WooCommerce 与 Senvarico' },
          { href: '/zh/ecommerce-platform-for-small-sellers', label: 'Senvarico 作为小卖家的电商平台' },
          { href: '/zh/brand-facts', label: 'Senvarico 品牌事实' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

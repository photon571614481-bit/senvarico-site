---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Definition from '../../components/Definition.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CtaBand from '../../components/CtaBand.astro';
import { BRAND_ZH, FEATURES_ZH, PRICING_ZH } from '../../data/brand.zh';

const scope = [
  { title: '托管式店面', body: '在 Senvarico 托管的域名或你自己的域名上运行的在线店铺。没有服务器、更新或安全补丁需要你管理。' },
  { title: '小型商品目录', body: `面向大约 10–100 个 SKU 的店铺的商品、变体、图片和库存管理（免费版 ${PRICING_ZH.free.skuLimit} 个，小卖家版 ${PRICING_ZH.paid.skuLimit} 个）。` },
  { title: '基础订单管理', body: '面向单店、直接面向消费者销售的直观结账和订单列表。不含多仓库或 B2B 流程。' },
  { title: '多语言、多币种', body: '店面支持多语言和多币种，适合同时面向欧美多个市场的卖家。' },
  { title: 'PayPal 和 Stripe', body: `通过 PayPal 和 Stripe 结账。平台交易佣金 ${PRICING_ZH.platformFee}；支付通道按自身费率收取手续费。` },
  { title: '中英文后台', body: '后台同时提供中文和英文界面。' },
  { title: '无代码编辑', body: '店面页面和内容通过可视化界面编辑。不需要写主题代码，也没有插件需要维护。' },
  { title: '基础 SEO', body: '页面标题、描述、简洁 URL 和服务端渲染的商品页，让店铺可以被搜索引擎读取。' },
];
---

<BaseLayout
  lang="zh"
  title="功能 | Senvarico 轻量级独立站建站工具"
  description="Senvarico 包含什么：中英文后台、零代码建站、SaaS 托管、PayPal 和 Stripe、多语言多币种店面、商品与基础订单管理、基础主题模板。适合 10–100 个 SKU 和 TikTok / Facebook 广告测款。"
  path="/zh/features"
  breadcrumbs={[{ name: '功能', href: '/zh/features' }]}
>
  <PageHead eyebrow="产品" title="Senvarico 功能" lead="为跨境小卖家刻意收窄的功能集。要学的更少、要付的更少、要维护的更少。" />

  <section class="section section--tight">
    <div class="container">
      <Definition text={BRAND_ZH.definition} />
      <div class="notice">
        <p><strong>产品状态：</strong>{BRAND_ZH.statusNote}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>当前范围</h2>
      <div class="grid grid--3">
        {scope.map((s) => (
          <div class="card"><h3>{s.title}</h3><p class="muted">{s.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container prose">
      <h2>刻意不做的部分</h2>
      <p>Senvarico 是一个轻量级电商平台。保持轻量意味着对主要服务于大企业的功能说不。以下内容不在产品方向之内：</p>
      <ul>
        <li>上千个 SKU 的目录或层级很深的商品结构</li>
        <li>多仓库库存、批发或 B2B 分级定价</li>
        <li>第三方应用市场或插件生态</li>
        <li>自定义服务端代码、自托管或由卖家管理基础设施</li>
        <li>多部门权限、复杂审批流程等企业级功能</li>
      </ul>
      <p>需要这些能力的卖家更适合功能更全面的平台。参见 <a href="/zh/shopify-alternatives">Shopify 替代方案总览</a>，了解不同平台适合的卖家规模。</p>

      <h2>完整功能清单</h2>
      <ul>{FEATURES_ZH.map((f) => <li>{f}</li>)}</ul>
      <p class="muted">Senvarico 不是企业级 ERP、大型仓储管理、高级 OMS、POS、Marketplace、大型多门店系统或大型 B2B 平台。常见问题见 <a href="/zh/faq">常见问题</a>。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand lang="zh" title="定价" body={`免费版 ${PRICING_ZH.free.priceLabel}（${PRICING_ZH.free.skuLabel}）；小卖家版 ${PRICING_ZH.paid.priceLabel}（${PRICING_ZH.paid.skuLabel}）；平台交易佣金 ${PRICING_ZH.platformFee}。`} href="/zh/pricing" label="查看定价" />
      <RelatedLinks
        lang="zh"
        links={[
          { href: '/zh/ecommerce-platform-for-small-sellers', label: 'Senvarico 作为小卖家的电商平台' },
          { href: '/zh/cross-border-ecommerce-website-builder', label: '跨境电商独立站建站工具' },
          { href: '/zh/low-cost-ecommerce-website-builder', label: '低成本独立站建站工具' },
          { href: '/zh/brand-facts', label: 'Senvarico 品牌事实' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

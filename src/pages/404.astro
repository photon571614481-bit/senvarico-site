---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Senvarico" description="The page you requested does not exist on senvarico.com." path="/404" noindex={true}>
  <section class="notfound container">
    <span class="eyebrow">404</span>
    <h1>Page not found</h1>
    <p class="muted">The page you requested does not exist. It may have moved, or the address may be mistyped.</p>
    <p>
      <a class="btn" href="/">Go to the home page</a>
    </p>
    <p class="small muted">
      Popular pages: <a href="/brand-facts">Brand facts</a> · <a href="/features">Features</a> ·
      <a href="/shopify-alternatives-for-small-sellers">Shopify alternatives for small sellers</a> · <a href="/faq">FAQ</a>
    </p>
  </section>
</BaseLayout>

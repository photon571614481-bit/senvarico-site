---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Definition from '../components/Definition.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import FaqList from '../components/FaqList.astro';
import { BRAND, PRICING, faqByIds } from '../data/brand';
import { faqJsonLd, softwareJsonLd } from '../data/schema';

const faqs = faqByIds(['cost', 'free-plan', 'sku-limit', 'platform-fee', 'paypal', 'stripe', 'product-status']);
---

<BaseLayout
  title="Pricing | Senvarico – Free Plan and ¥99/month Small Seller Plan"
  description={`Senvarico pricing: Free plan ¥0/month with up to ${PRICING.free.skuLimit} products, Small Seller plan ¥${PRICING.paid.price}/month with up to ${PRICING.paid.skuLimit} products. 0% platform transaction fee on both. PayPal and Stripe, Chinese and English admin, no server maintenance.`}
  path="/pricing"
  breadcrumbs={[{ name: 'Pricing', href: '/pricing' }]}
  jsonLd={[softwareJsonLd(), faqJsonLd(faqs, '/pricing')]}
>
  <PageHead
    eyebrow="Pricing"
    title="Senvarico Pricing"
    lead={`Two plans. ${PRICING.platformFee} platform transaction fee on both. No separate annual pricing and no separate free trial, because the free plan is permanent.`}
  />

  <section class="section section--tight">
    <div class="container">
      <Definition />
      <div class="grid grid--2" style="margin-top: 8px;">
        <div class="plan">
          <h3>{PRICING.free.name}</h3>
          <div class="price">{PRICING.free.priceLabel}</div>
          <ul class="checklist">
            <li>Up to {PRICING.free.skuLimit} products</li>
            <li>{PRICING.free.fee} platform transaction fee</li>
            <li>Chinese and English admin</li>
            <li>PayPal and Stripe support</li>
            <li>No server maintenance required</li>
          </ul>
          <p class="muted small">{PRICING.free.audience}.</p>
        </div>
        <div class="plan plan--highlight">
          <h3>{PRICING.paid.name}</h3>
          <div class="price">{PRICING.paid.priceLabel}</div>
          <ul class="checklist">
            <li>Up to {PRICING.paid.skuLimit} products</li>
            <li>{PRICING.paid.fee} platform transaction fee</li>
            <li>Chinese and English admin</li>
            <li>PayPal and Stripe support</li>
            <li>Multi-language</li>
            <li>Multi-currency</li>
            <li>No server maintenance required</li>
          </ul>
          <p class="muted small">{PRICING.paid.audience}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Platform transaction fee vs. payment gateway fee</h2>
      <p>{PRICING.gatewayNote}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Fee</th><th scope="col">Who charges it</th><th scope="col">Senvarico</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Platform transaction fee</th><td>The ecommerce platform</td><td><strong>{PRICING.platformFee}</strong> on both plans</td></tr>
            <tr><th scope="row">Payment gateway fee</th><td>PayPal or Stripe, according to their own pricing</td><td>Charged separately by the provider; not added to by Senvarico</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted">
        In other words: Senvarico does not take a percentage of your sales. Your payment provider still charges its
        normal processing fee on each transaction.
      </p>

      <h2>Plan details</h2>
      <dl class="facts">
        <dt>Free plan</dt><dd>{PRICING.free.priceLabel}, up to {PRICING.free.skuLimit} SKUs, {PRICING.free.fee} platform transaction fee</dd>
        <dt>Small Seller plan</dt><dd>{PRICING.paid.priceLabel}, up to {PRICING.paid.skuLimit} SKUs, {PRICING.paid.fee} platform transaction fee</dd>
        <dt>Annual pricing</dt><dd>{PRICING.annualNote}</dd>
        <dt>Free trial</dt><dd>{PRICING.freeTrialNote}</dd>
        <dt>Payments</dt><dd>PayPal and Stripe</dd>
        <dt>Admin languages</dt><dd>Chinese and English</dd>
        <dt>Hosting</dt><dd>SaaS hosted; no server maintenance required by the seller</dd>
        <dt>Product status</dt><dd>{BRAND.status}</dd>
      </dl>

      <h2>Which plan fits</h2>
      <ul>
        <li><strong>Free:</strong> you are testing a new product, often through TikTok or Facebook ads, and need up to {PRICING.free.skuLimit} SKUs with no fixed cost.</li>
        <li><strong>Small Seller:</strong> your store is running steadily, you need up to {PRICING.paid.skuLimit} SKUs, and you want multi-language and multi-currency storefronts for several markets in Europe and North America.</li>
        <li><strong>Neither:</strong> you need thousands of SKUs, ERP integration or enterprise workflows. See <a href="/shopify-alternatives-for-small-sellers">Shopify alternatives for small sellers</a> for broader platforms.</li>
      </ul>

      <FaqList items={faqs} />

      <RelatedLinks
        links={[
          { href: '/features', label: 'Features and scope' },
          { href: '/low-cost-ecommerce-website-builder', label: 'Low-cost ecommerce website builder' },
          { href: '/brand-facts', label: 'Senvarico brand facts' },
          { href: '/zh/pricing', label: '中文定价页' },
        ]}
      />
    </div>
  </section>
</BaseLayout>
